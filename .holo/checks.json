{
  "checks": [
    {
      "name": "engine",
      "run": "cargo test --release",
      "cwd": "engine",
      "inputs": [
        "engine"
      ],
      "tools": [
        {
          "run": "cargo --version",
          "expect": "cargo 1."
        }
      ],
      "keep": [
        "engine/target"
      ]
    },
    {
      "name": "wasm",
      "run": "sh scripts/build-engine.sh",
      "inputs": [
        "engine",
        "scripts/build-engine.sh"
      ],
      "outputs": [
        "web/engine.wasm"
      ],
      "tools": [
        {
          "run": "cargo --version",
          "expect": "cargo 1."
        }
      ],
      "keep": [
        "engine/target"
      ]
    },
    {
      "name": "page",
      "run": "npm ci --no-audit --no-fund && npm test",
      "inputs": [
        "web",
        "test",
        "scripts",
        "package.json",
        "package-lock.json"
      ],
      "tools": [
        {
          "run": "node --version",
          "expect": "v22."
        },
        {
          "run": "git --version",
          "expect": "git version 2."
        }
      ],
      "keep": [
        "node_modules"
      ],
      "uses": [
        "wasm"
      ]
    },
    {
      "name": "store",
      "run": "npm ci --no-audit --no-fund && node --test test/s3.test.mjs",
      "inputs": [
        "web",
        "test",
        "scripts",
        "package.json",
        "package-lock.json"
      ],
      "tools": [
        {
          "run": "node --version",
          "expect": "v22."
        },
        {
          "run": "git --version",
          "expect": "git version 2."
        }
      ],
      "env": [
        "S3_TEST_ENDPOINT",
        "S3_TEST_ACCESS_KEY",
        "S3_TEST_SECRET_KEY"
      ],
      "keep": [
        "node_modules"
      ],
      "uses": [
        "wasm"
      ]
    },
    {
      "name": "model",
      "run": "npx --yes prism-code@0.8.0 verify --lean --hosted",
      "inputs": [
        "src",
        "language",
        "lexlean.toml",
        "lexlean.lock",
        "lean-toolchain",
        "lakefile.toml",
        "lake-manifest.json",
        "prism.toml",
        "prismpm.toml",
        "prismpm.lock",
        "standards.lock"
      ],
      "tools": [
        {
          "run": "node --version",
          "expect": "v22."
        }
      ]
    }
  ]
}
